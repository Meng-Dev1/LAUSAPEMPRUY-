            -- ==========================================
            -- ADD LABEL (support Calculating....)
            -- ==========================================
            function Section:AddLabel(name, value)
                local Lbl = {}
                local Row = MakeRow(name)
                local dots = {".", "..", "...", "...."}
                local dotIdx = 1
                local animating = false
                local animConn = nil

                local ValLabel = Create("TextLabel", {
                    Size            = UDim2.new(0.55, 0, 1, 0),
                    Position        = UDim2.new(0.45, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text            = value or "",
                    TextColor3      = T.TextSecond,
                    TextSize        = 11,
                    Font            = Enum.Font.Gotham,
                    TextXAlignment  = Enum.TextXAlignment.Right,
                    TextTruncate    = Enum.TextTruncate.AtEnd,
                    Parent          = Row
                })
                AddPadding(ValLabel, 0, 0, 0, 10)

                -- Auto animasi kalau teks "Calculating"
                local function StartCalcAnim()
                    animating = true
                    animConn = RunService.Heartbeat:Connect(function()
                        if not animating then
                            if animConn then animConn:Disconnect() end
                            return
                        end
                    end)
                    coroutine.wrap(function()
                        local base = "Calculating"
                        while animating do
                            ValLabel.Text = base .. dots[dotIdx]
                            ValLabel.TextColor3 = T.TextHint
                            dotIdx = (dotIdx % 4) + 1
                            wait(0.4)
                        end
                    end)()
                end

                if value and string.lower(value):find("calculating") then
                    StartCalcAnim()
                end

                function Lbl:Set(newVal)
                    animating = false
                    ValLabel.Text = tostring(newVal)
                    Tween(ValLabel, { TextColor3 = T.Accent }, 0.2)
                    wait(0.6)
                    Tween(ValLabel, { TextColor3 = T.TextPrimary }, 0.3)
                end

                function Lbl:SetCalculating()
                    ValLabel.Text = "Calculating...."
                    StartCalcAnim()
                end

                function Lbl:Get() return ValLabel.Text end

                return Lbl
            end

