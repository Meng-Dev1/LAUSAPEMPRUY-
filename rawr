            -- ==========================================
            -- ADD SLIDER
            -- ==========================================
            function Section:AddSlider(name, min, max, default, callback)
                local Slider = {}
                local val = default or min
                local Row = Create("Frame", {
                    Size            = UDim2.new(1, 0, 0, 46),
                    BackgroundColor3 = T.Row,
                    BorderSizePixel = 0,
                    Parent          = ItemsFrame
                })
                AddCorner(Row, 6)

                Create("TextLabel", {
                    Size            = UDim2.new(0.7, 0, 0, 18),
                    Position        = UDim2.new(0, 10, 0, 6),
                    BackgroundTransparency = 1,
                    Text            = name,
                    TextColor3      = T.TextPrimary,
                    TextSize        = 12,
                    Font            = Enum.Font.GothamBold,
                    TextXAlignment  = Enum.TextXAlignment.Left,
                    Parent          = Row
                })

                local ValTxt = Create("TextLabel", {
                    Size            = UDim2.new(0.3, -10, 0, 18),
                    Position        = UDim2.new(0.7, 0, 0, 6),
                    BackgroundTransparency = 1,
                    Text            = tostring(val),
                    TextColor3      = T.Accent,
                    TextSize        = 12,
                    Font            = Enum.Font.GothamBold,
                    TextXAlignment  = Enum.TextXAlignment.Right,
                    Parent          = Row
                })

                -- Track background
                local Track = Create("Frame", {
                    Size            = UDim2.new(1, -20, 0, 4),
                    Position        = UDim2.new(0, 10, 0, 32),
                    BackgroundColor3 = T.Border,
                    BorderSizePixel = 0,
                    Parent          = Row
                })
                AddCorner(Track, 2)

                -- Fill
                local pct = (val - min) / (max - min)
                local Fill = Create("Frame", {
                    Size            = UDim2.new(pct, 0, 1, 0),
                    BackgroundColor3 = T.Accent,
                    BorderSizePixel = 0,
                    Parent          = Track
                })
                AddCorner(Fill, 2)

                -- Draggable logic
                local sliding = false
                local Hitbox = Create("TextButton", {
                    Size            = UDim2.new(1, 0, 0, 20),
                    Position        = UDim2.new(0, 0, 0, 26),
                    BackgroundTransparency = 1,
                    Text            = "",
                    Parent          = Row
                })

                local function UpdateSlider(input)
                    local rel = (input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X
                    rel = math.clamp(rel, 0, 1)
                    val = math.floor(min + (max - min) * rel)
                    Fill.Size = UDim2.new(rel, 0, 1, 0)
                    ValTxt.Text = tostring(val)
                    if callback then callback(val) end
                end

                Hitbox.MouseButton1Down:Connect(function()
                    sliding = true
                    UpdateSlider(UserInputService:GetMouseLocation() and {Position = Vector2.new(Mouse.X, Mouse.Y)} or {Position = Vector2.new(0,0)})
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                        UpdateSlider(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        sliding = false
                    end
                end)

                function Slider:Set(newVal)
                    val = math.clamp(newVal, min, max)
                    local p = (val - min) / (max - min)
                    Fill.Size = UDim2.new(p, 0, 1, 0)
                    ValTxt.Text = tostring(val)
                end
                function Slider:Get() return val end

                return Slider
            end

            -- ==========================================
            -- ADD DROPDOWN
            -- ==========================================
            function Section:AddDropdown(name, options, default, callback)
                local DD = {}
                local selected = default or options[1]
                local open = false

                local Wrapper = Create("Frame", {
                    Size            = UDim2.new(1, 0, 0, 32),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ClipsDescendants = false,
                    Parent          = ItemsFrame
                })

                local MainRow = Create("Frame", {
                    Size            = UDim2.new(1, 0, 0, 32),
                    BackgroundColor3 = T.Row,
                    BorderSizePixel = 0,
                    Parent          = Wrapper
                })
                AddCorner(MainRow, 6)

                Create("TextLabel", {
                    Size            = UDim2.new(0.5, 0, 1, 0),
                    Position        = UDim2.new(0, 10, 0, 0),
                    BackgroundTransparency = 1,
                    Text            = name,
                    TextColor3      = T.TextPrimary,
                    TextSize        = 12,
                    Font            = Enum.Font.GothamBold,
                    TextXAlignment  = Enum.TextXAlignment.Left,
                    Parent          = MainRow
                })

                local SelLabel = Create("TextLabel", {
                    Size            = UDim2.new(0.45, -30, 1, 0),
                    Position        = UDim2.new(0.5, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text            = selected,
                    TextColor3      = T.Accent,
                    TextSize        = 11,
                    Font            = Enum.Font.Gotham,
                    TextXAlignment  = Enum.TextXAlignment.Right,
                    Parent          = MainRow
                })

                local Arrow = Create("TextLabel", {
                    Size            = UDim2.new(0, 20, 1, 0),
                    Position        = UDim2.new(1, -24, 0, 0),
                    BackgroundTransparency = 1,
                    Text            = "▾",
                    TextColor3      = T.TextSecond,
                    TextSize        = 12,
                    Font            = Enum.Font.Gotham,
                    Parent          = MainRow
                })

                -- Dropdown menu
                local MenuFrame = Create("Frame", {
                    Size            = UDim2.new(1, 0, 0, 0),
                    Position        = UDim2.new(0, 0, 0, 34),
                    BackgroundColor3 = Color3.fromRGB(22, 22, 22),
                    BorderSizePixel = 0,
                    ClipsDescendants = true,
                    ZIndex          = 10,
                    Parent          = Wrapper
                })
                AddCorner(MenuFrame, 6)
                Create("UIStroke", { Color = T.Border, Thickness = 1, Parent = MenuFrame })

                local MenuLayout = AddListLayout(MenuFrame, 2)
                AddPadding(MenuFrame, 4, 4, 4, 4)

                for _, opt in ipairs(options) do
                    local OptBtn = Create("TextButton", {
                        Size            = UDim2.new(1, 0, 0, 26),
                        BackgroundColor3 = Color3.fromRGB(28, 28, 28),
                        BorderSizePixel = 0,
                        Text            = opt,
                        TextColor3      = opt == selected and T.Accent or T.TextSecond,
                        TextSize        = 11,
                        Font            = Enum.Font.Gotham,
                        ZIndex          = 11,
                        Parent          = MenuFrame
                    })
                    AddCorner(OptBtn, 4)
                    OptBtn.MouseButton1Click:Connect(function()
                        selected = opt
                        SelLabel.Text = selected
                        -- Reset semua option color
                        for _, c in pairs(MenuFrame:GetChildren()) do
                            if c:IsA("TextButton") then
                                c.TextColor3 = T.TextSecond
                            end
                        end
                        OptBtn.TextColor3 = T.Accent
                        if callback then callback(selected) end
                        -- Close
                        open = false
                        Arrow.Text = "▾"
                        Tween(MenuFrame, { Size = UDim2.new(1, 0, 0, 0) }, 0.15)
                        Wrapper.Size = UDim2.new(1, 0, 0, 32)
                    end)
                end

                -- Toggle open/close
                local ToggleBtn = Create("TextButton", {
                    Size            = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text            = "",
                    ZIndex          = 5,
                    Parent          = MainRow
                })
                ToggleBtn.MouseButton1Click:Connect(function()
                    open = not open
                    local menuH = MenuLayout.AbsoluteContentSize.Y + 12
                    Arrow.Text = open and "▴" or "▾"
                    if open then
                        Wrapper.Size = UDim2.new(1, 0, 0, 32 + menuH + 4)
                        Tween(MenuFrame, { Size = UDim2.new(1, 0, 0, menuH) }, 0.15)
                    else
                        Tween(MenuFrame, { Size = UDim2.new(1, 0, 0, 0) }, 0.15)
                        wait(0.15)
                        Wrapper.Size = UDim2.new(1, 0, 0, 32)
                    end
                end)

                function DD:Set(val)
                    selected = val
                    SelLabel.Text = val
                end
                function DD:Get() return selected end

                return DD
            end

            return Section
        end

        return Tab
    end

    -- Popup notif
    function Window:Notify(msg, duration)
        duration = duration or 3
        local Notif = Create("Frame", {
            Size            = UDim2.new(0, 220, 0, 40),
            Position        = UDim2.new(1, -230, 1, 10),
            BackgroundColor3 = T.Surface,
            BorderSizePixel = 0,
            Parent          = MainFrame
        })
        AddCorner(Notif, 8)
        Create("UIStroke", { Color = T.Accent, Thickness = 1, Parent = Notif })
        Create("TextLabel", {
            Size            = UDim2.new(1, -16, 1, 0),
            Position        = UDim2.new(0, 8, 0, 0),
            BackgroundTransparency = 1,
            Text            = msg,
            TextColor3      = T.TextPrimary,
            TextSize        = 11,
            Font            = Enum.Font.Gotham,
            TextXAlignment  = Enum.TextXAlignment.Left,
            TextWrapped     = true,
            Parent          = Notif
        })
        Tween(Notif, { Position = UDim2.new(1, -230, 1, -50) }, 0.25)
        wait(duration)
        Tween(Notif, { Position = UDim2.new(1, -230, 1, 10) }, 0.2)
        wait(0.2)
        Notif:Destroy()
    end

    -- Destroy / cleanup
    function Window:Destroy()
        ScreenGui:Destroy()
    end

    return Window
end

return Library
