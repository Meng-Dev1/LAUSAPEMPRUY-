        gui:Destroy()
    end)

    -- Tab bar
    local tabBar = New("Frame", {
        Name = "TabBar",
        Parent = window,
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, 48),
